{
    "name": "astral-php/astral-shipping",
    "description": "Frais de port multi-options pour Astral : forfait, barèmes poids/pays, Colissimo, Mondial Relay, retrait boutique, API agrégateur (Sendcloud)",
    "type": "library",
    "version": "0.5.2",
    "license": "MIT",
    "keywords": ["astral", "php", "shipping", "frais-de-port", "colissimo", "mondial-relay", "sendcloud"],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-shipping",
    "support": {
        "source": "https://github.com/astral-php/astral-shipping",
        "issues": "https://github.com/astral-php/astral-shipping/issues"
    },
    "require": {
        "php": "^8.1",
        "astral-php/astral-core": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "ext-curl": "Requis par CurlHttpClient (méthodes API comme Sendcloud)",
        "astral-php/astral-payment": "Paiement Stripe : le montant du PaymentIntent = panier + frais de port"
    },
    "autoload": {
        "psr-4": {
            "AstralShipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstralShipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "astral-shipping": {
            "stubs": "stubs"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
